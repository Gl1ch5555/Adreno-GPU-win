+static HRESULT APIENTRY add_to_state_object(D3D12DDI_HDEVICE h, const D3D12DDIARG_ADD_TO_STATE_OBJECT_0072 *args,
+        D3D12DDI_HSTATEOBJECT_0054 handle, D3D12DDI_HRTSTATEOBJECT_0054 rt) {
+    (void)rt;
+    D3D12_UMD_Device *device = umd_device(h);
+    D3D12_UMD_StateObject *so = handle.pDrvPrivate;
+    D3D12_UMD_StateObject *base = args->StateObjectToGrowFrom.pDrvPrivate;
+    memset(so, 0, sizeof(*so));
+    if (!base || !base->so)
+        return E_INVALIDARG;
+
+    ID3D12Device7 *dev7;
+    HRESULT hr = ID3D12Device_QueryInterface(device->d3d12, &IID_ID3D12Device7, (void **)&dev7);
+    if (FAILED(hr))
+        return hr;
+
+    D3D12_STATE_OBJECT_DESC desc;
+    void **allocs = NULL;
+    UINT na = 0;
+    hr = build_api_state_object_desc(args->NumSubobjects, args->pSubobjects,
+            (D3D12_STATE_OBJECT_TYPE)args->Type, &desc, &allocs, &na);
+    if (SUCCEEDED(hr)) {
+        hr = ID3D12Device7_AddToStateObject(dev7, &desc, base->so, &IID_ID3D12StateObject, (void **)&so->so);
+        free_state_object_allocs(allocs, na);
+    }
+    ID3D12Device7_Release(dev7);
+    if (SUCCEEDED(hr) && so->so)
+        ID3D12StateObject_QueryInterface(so->so, &IID_ID3D12StateObjectProperties, (void **)&so->props);
+    return hr;
+}
