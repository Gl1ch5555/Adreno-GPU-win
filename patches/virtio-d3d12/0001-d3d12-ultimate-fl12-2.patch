+static HRESULT build_api_state_object_desc(UINT num_sub, const D3D12DDI_STATE_SUBOBJECT_0054 *subs,
+        D3D12_STATE_OBJECT_TYPE type, D3D12_STATE_OBJECT_DESC *out_desc, void ***allocs_out, UINT *alloc_count_out) {
+    D3D12_STATE_SUBOBJECT *api_subs = calloc(num_sub ? num_sub : 1, sizeof(*api_subs));
+    void **allocs = calloc((num_sub ? num_sub : 1) * 3 + 1, sizeof(void *));
+    if (!api_subs || !allocs) {
+        free(api_subs);
+        free(allocs);
+        return E_OUTOFMEMORY;
+    }
+    UINT na = 0, out_n = 0;
+    allocs[na++] = api_subs;
+
+    for (UINT i = 0; i < num_sub; i++) {
+        const D3D12DDI_STATE_SUBOBJECT_0054 *s = &subs[i];
+        switch (s->Type) {
+        case D3D12DDI_STATE_SUBOBJECT_TYPE_STATE_OBJECT_CONFIG: {
+            D3D12_STATE_OBJECT_CONFIG *cfg = calloc(1, sizeof(*cfg));
+            if (!cfg) goto oom;
+            allocs[na++] = cfg;
+            cfg->Flags = (D3D12_STATE_OBJECT_FLAGS)((const D3D12DDI_STATE_OBJECT_CONFIG_0054 *)s->pDesc)->Flags;
+            api_subs[out_n++] = (D3D12_STATE_SUBOBJECT){ D3D12_STATE_SUBOBJECT_TYPE_STATE_OBJECT_CONFIG, cfg };
+            break;
+        }
+        case D3D12DDI_STATE_SUBOBJECT_TYPE_GLOBAL_ROOT_SIGNATURE: {
+            D3D12_GLOBAL_ROOT_SIGNATURE *grs = calloc(1, sizeof(*grs));
+            if (!grs) goto oom;
+            allocs[na++] = grs;
+            grs->pGlobalRootSignature = umd_root_signature(((const D3D12DDI_GLOBAL_ROOT_SIGNATURE_0054 *)s->pDesc)->hGlobalRootSignature);
+            api_subs[out_n++] = (D3D12_STATE_SUBOBJECT){ D3D12_STATE_SUBOBJECT_TYPE_GLOBAL_ROOT_SIGNATURE, grs };
+            break;
+        }
+        case D3D12DDI_STATE_SUBOBJECT_TYPE_LOCAL_ROOT_SIGNATURE: {
+            D3D12_LOCAL_ROOT_SIGNATURE *lrs = calloc(1, sizeof(*lrs));
+            if (!lrs) goto oom;
+            allocs[na++] = lrs;
+            lrs->pLocalRootSignature = umd_root_signature(((const D3D12DDI_LOCAL_ROOT_SIGNATURE_0054 *)s->pDesc)->hLocalRootSignature);
+            api_subs[out_n++] = (D3D12_STATE_SUBOBJECT){ D3D12_STATE_SUBOBJECT_TYPE_LOCAL_ROOT_SIGNATURE, lrs };
+            break;
+        }
+        case D3D12DDI_STATE_SUBOBJECT_TYPE_NODE_MASK: {
+            D3D12_NODE_MASK *nm = calloc(1, sizeof(*nm));
+            if (!nm) goto oom;
+            allocs[na++] = nm;
+            nm->NodeMask = ((const D3D12DDI_NODE_MASK_0054 *)s->pDesc)->NodeMask;
+            api_subs[out_n++] = (D3D12_STATE_SUBOBJECT){ D3D12_STATE_SUBOBJECT_TYPE_NODE_MASK, nm };
+            break;
+        }
+        case D3D12DDI_STATE_SUBOBJECT_TYPE_DXIL_LIBRARY: {
+            const D3D12DDI_DXIL_LIBRARY_DESC_0054 *dl = s->pDesc;
+            D3D12_DXIL_LIBRARY_DESC *adl = calloc(1, sizeof(*adl));
+            if (!adl) goto oom;
+            allocs[na++] = adl;
+            SIZE_T dxbc_sz = 0;
+            void *dxbc = d3d12_umd_wrap_dxil_library(dl->pDXILLibrary, &dxbc_sz);
+            if (!dxbc) goto oom;
+            allocs[na++] = dxbc;
+            adl->DXILLibrary = (D3D12_SHADER_BYTECODE){ dxbc, dxbc_sz };
+            adl->NumExports = dl->NumExports;
+            static_assert(sizeof(D3D12DDI_EXPORT_DESC_0054) == sizeof(D3D12_EXPORT_DESC));
+            adl->pExports = (const D3D12_EXPORT_DESC *)dl->pExports;
+            api_subs[out_n++] = (D3D12_STATE_SUBOBJECT){ D3D12_STATE_SUBOBJECT_TYPE_DXIL_LIBRARY, adl };
+            break;
+        }
+        case D3D12DDI_STATE_SUBOBJECT_TYPE_EXISTING_COLLECTION: {
+            const D3D12DDI_EXISTING_COLLECTION_DESC_0054 *ec = s->pDesc;
+            D3D12_UMD_StateObject *existing = ec->hExistingCollection.pDrvPrivate;
+            D3D12_EXISTING_COLLECTION_DESC *aec = calloc(1, sizeof(*aec));
+            if (!aec) goto oom;
+            allocs[na++] = aec;
+            aec->pExistingCollection = existing ? existing->so : NULL;
+            aec->NumExports = ec->NumExports;
+            aec->pExports = (const D3D12_EXPORT_DESC *)ec->pExports;
+            api_subs[out_n++] = (D3D12_STATE_SUBOBJECT){ D3D12_STATE_SUBOBJECT_TYPE_EXISTING_COLLECTION, aec };
+            break;
+        }
+        case D3D12DDI_STATE_SUBOBJECT_TYPE_RAYTRACING_SHADER_CONFIG: {
+            const D3D12DDI_RAYTRACING_SHADER_CONFIG_0054 *sc = s->pDesc;
+            D3D12_RAYTRACING_SHADER_CONFIG *asc = calloc(1, sizeof(*asc));
+            if (!asc) goto oom;
+            allocs[na++] = asc;
+            asc->MaxPayloadSizeInBytes = sc->MaxPayloadSizeInBytes;
+            asc->MaxAttributeSizeInBytes = sc->MaxAttributeSizeInBytes;
+            api_subs[out_n++] = (D3D12_STATE_SUBOBJECT){ D3D12_STATE_SUBOBJECT_TYPE_RAYTRACING_SHADER_CONFIG, asc };
+            break;
+        }
+        case D3D12DDI_STATE_SUBOBJECT_TYPE_RAYTRACING_PIPELINE_CONFIG: {
+            const D3D12DDI_RAYTRACING_PIPELINE_CONFIG_0075 *pc = s->pDesc;
+            D3D12_RAYTRACING_PIPELINE_CONFIG1 *apc = calloc(1, sizeof(*apc));
+            if (!apc) goto oom;
+            allocs[na++] = apc;
+            apc->MaxTraceRecursionDepth = pc->MaxTraceRecursionDepth;
+            apc->Flags = (D3D12_RAYTRACING_PIPELINE_FLAGS)pc->Flags;
+            api_subs[out_n++] = (D3D12_STATE_SUBOBJECT){ D3D12_STATE_SUBOBJECT_TYPE_RAYTRACING_PIPELINE_CONFIG1, apc };
+            break;
+        }
+        case D3D12DDI_STATE_SUBOBJECT_TYPE_HIT_GROUP: {
+            const D3D12DDI_HIT_GROUP_DESC_0054 *hg = s->pDesc;
+            D3D12_HIT_GROUP_DESC *ahg = calloc(1, sizeof(*ahg));
+            if (!ahg) goto oom;
+            allocs[na++] = ahg;
+            ahg->HitGroupExport = hg->HitGroupExport;
+            ahg->Type = (D3D12_HIT_GROUP_TYPE)hg->Type;
+            ahg->AnyHitShaderImport = hg->AnyHitShaderImport;
+            ahg->ClosestHitShaderImport = hg->ClosestHitShaderImport;
+            ahg->IntersectionShaderImport = hg->IntersectionShaderImport;
+            api_subs[out_n++] = (D3D12_STATE_SUBOBJECT){ D3D12_STATE_SUBOBJECT_TYPE_HIT_GROUP, ahg };
+            break;
+        }
+        default:
+            /* Ignore DDI-only export summaries (0x100000). */
+            break;
+        }
+    }
+
+    *out_desc = (D3D12_STATE_OBJECT_DESC){ type, out_n, api_subs };
+    *allocs_out = allocs;
+    *alloc_count_out = na;
+    return S_OK;
+oom:
+    for (UINT k = 0; k < na; k++)
+        free(allocs[k]);
+    free(allocs);
+    return E_OUTOFMEMORY;
+}
