+static void APIENTRY cl_barrier(D3D12DDI_HCOMMANDLIST h, UINT32 num_barriers,
+        const D3D12DDIARG_BARRIER_0094 *barriers) {
+    if (!num_barriers || !barriers)
+        return;
+    ID3D12GraphicsCommandList7 *cl7;
+    if (FAILED(ID3D12GraphicsCommandList2_QueryInterface(umd_cl(h)->cl, &IID_ID3D12GraphicsCommandList7, (void **)&cl7)))
+        return;
+
+    D3D12_GLOBAL_BARRIER *globals = calloc(num_barriers, sizeof(*globals));
+    D3D12_TEXTURE_BARRIER *textures = calloc(num_barriers, sizeof(*textures));
+    D3D12_BUFFER_BARRIER *buffers = calloc(num_barriers, sizeof(*buffers));
+    if (globals && textures && buffers) {
+        UINT32 ng = 0, nt = 0, nb = 0;
+        for (UINT32 i = 0; i < num_barriers; i++) {
+            const D3D12DDIARG_BARRIER_0094 *b = &barriers[i];
+            if (b->Type == D3D12DDI_BARRIER_TYPE_GLOBAL) {
+                globals[ng++] = (D3D12_GLOBAL_BARRIER){
+                    (D3D12_BARRIER_SYNC)b->GlobalBarrier.SyncBefore,
+                    (D3D12_BARRIER_SYNC)b->GlobalBarrier.SyncAfter,
+                    (D3D12_BARRIER_ACCESS)b->GlobalBarrier.AccessBefore,
+                    (D3D12_BARRIER_ACCESS)b->GlobalBarrier.AccessAfter,
+                };
+            } else if (b->Type == D3D12DDI_BARRIER_TYPE_TEXTURE) {
+                const D3D12DDI_TEXTURE_BARRIER_0088 *tb = &b->TextureBarrier;
+                textures[nt++] = (D3D12_TEXTURE_BARRIER){
+                    .SyncBefore = (D3D12_BARRIER_SYNC)tb->SyncBefore,
+                    .SyncAfter = (D3D12_BARRIER_SYNC)tb->SyncAfter,
+                    .AccessBefore = (D3D12_BARRIER_ACCESS)tb->AccessBefore,
+                    .AccessAfter = (D3D12_BARRIER_ACCESS)tb->AccessAfter,
+                    .LayoutBefore = (D3D12_BARRIER_LAYOUT)tb->LayoutBefore,
+                    .LayoutAfter = (D3D12_BARRIER_LAYOUT)tb->LayoutAfter,
+                    .pResource = umd_res(tb->hResource),
+                    .Subresources = {
+                        tb->Subresources.IndexOrFirstMipLevel, tb->Subresources.NumMipLevels,
+                        tb->Subresources.FirstArraySlice, tb->Subresources.NumArraySlices,
+                        tb->Subresources.FirstPlane, tb->Subresources.NumPlanes,
+                    },
+                    .Flags = (D3D12_TEXTURE_BARRIER_FLAGS)tb->Flags,
+                };
+            } else if (b->Type == D3D12DDI_BARRIER_TYPE_BUFFER) {
+                const D3D12DDI_BUFFER_BARRIER_0088 *bb = &b->BufferBarrier;
+                buffers[nb++] = (D3D12_BUFFER_BARRIER){
+                    .SyncBefore = (D3D12_BARRIER_SYNC)bb->SyncBefore,
+                    .SyncAfter = (D3D12_BARRIER_SYNC)bb->SyncAfter,
+                    .AccessBefore = (D3D12_BARRIER_ACCESS)bb->AccessBefore,
+                    .AccessAfter = (D3D12_BARRIER_ACCESS)bb->AccessAfter,
+                    .pResource = umd_res(bb->hResource),
+                    .Offset = 0,
+                    .Size = UINT64_MAX,
+                };
+            }
+        }
+        D3D12_BARRIER_GROUP groups[3];
+        UINT32 group_count = 0;
+        if (ng) groups[group_count++] = (D3D12_BARRIER_GROUP){ .Type = D3D12_BARRIER_TYPE_GLOBAL, .NumBarriers = ng, .pGlobalBarriers = globals };
+        if (nt) groups[group_count++] = (D3D12_BARRIER_GROUP){ .Type = D3D12_BARRIER_TYPE_TEXTURE, .NumBarriers = nt, .pTextureBarriers = textures };
+        if (nb) groups[group_count++] = (D3D12_BARRIER_GROUP){ .Type = D3D12_BARRIER_TYPE_BUFFER, .NumBarriers = nb, .pBufferBarriers = buffers };
+        if (group_count)
+            ID3D12GraphicsCommandList7_Barrier(cl7, group_count, groups);
+    }
+    free(globals);
+    free(textures);
+    free(buffers);
+    ID3D12GraphicsCommandList7_Release(cl7);
+}
