diff --git a/vk_bootstrap.c b/vk_bootstrap.c
index 3daf36a..b8dbf33 100644
--- a/vk_bootstrap.c
+++ b/vk_bootstrap.c
@@ -175,17 +175,22 @@ static HRESULT get_drm_context_type(HANDLE hRTAdapter, HANDLE hRTDevice, const D
 static HMODULE load_icd(const wchar_t *icd_name) {
     wchar_t umd_path[MAX_PATH];
     HMODULE umd_module = NULL;
-#if defined(__i386__)
-    /* The signed package contains both 64-bit and WoW dependencies. */
-    wchar_t wow_name[MAX_PATH];
+    /* Each ABI loads its matching DriverStore DLL (_x86, _arm64ec, _arm64). */
+    wchar_t arch_name[MAX_PATH];
     const wchar_t *suffix = wcsrchr(icd_name, L'.');
     if (!suffix || wcscmp(suffix, L".dll") != 0) return NULL;
     size_t stem = suffix - icd_name;
-    if (stem + ARRAYSIZE(L"_x86.dll") > ARRAYSIZE(wow_name)) return NULL;
-    wmemcpy(wow_name, icd_name, stem);
-    wcscpy(wow_name + stem, L"_x86.dll");
-    icd_name = wow_name;
+#if defined(__i386__)
+    const wchar_t *arch_ext = L"_x86.dll";
+#elif defined(__arm64ec__)
+    const wchar_t *arch_ext = L"_arm64ec.dll";
+#else
+    const wchar_t *arch_ext = L"_arm64.dll";
 #endif
+    if (stem + wcslen(arch_ext) + 1 > ARRAYSIZE(arch_name)) return NULL;
+    wmemcpy(arch_name, icd_name, stem);
+    wcscpy(arch_name + stem, arch_ext);
+    icd_name = arch_name;
 
     GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
                        (LPCWSTR)&load_icd, &umd_module);
