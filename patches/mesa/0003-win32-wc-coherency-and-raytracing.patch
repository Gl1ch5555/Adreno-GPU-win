-      req.flags &= ~(MSM_BO_CACHED | MSM_BO_WC | MSM_BO_UNCACHED);
-      req.flags |= MSM_BO_CACHED_COHERENT;
+      /* GuestBacking maps pages with MmWriteCombined so CPU writes bypass
