+      req.flags &= ~(MSM_BO_CACHED | MSM_BO_WC | MSM_BO_UNCACHED | MSM_BO_CACHED_COHERENT);
+      if (dev->physical_device->has_cached_coherent_memory)
+         req.flags |= MSM_BO_CACHED_COHERENT;
+      else
+         req.flags |= MSM_BO_WC;
 #endif
    }
 
